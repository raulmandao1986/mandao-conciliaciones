{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user with RBAC profile",
      "type": "object",
      "properties": {
        "nombre": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "rol": { "type": "string" },
        "estado": { "type": "string", "enum": ["activo", "bloqueado"] },
        "ultimoAcceso": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nombre", "email", "rol", "estado"]
    },
    "Role": {
      "title": "Role",
      "description": "Permission set for internal users",
      "type": "object",
      "properties": {
        "nombre": { "type": "string" },
        "descripcion": { "type": "string" },
        "permisos": { "type": "array", "items": { "type": "string" } },
        "usuariosAsignados": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nombre", "permisos"]
    },
    "Business": {
      "title": "Business",
      "description": "Profile for partner establishments",
      "type": "object",
      "properties": {
        "negocio": { "type": "string" },
        "metodoPago": { "type": "string" },
        "estado": { "type": "string", "enum": ["activo", "bloqueado"] },
        "area": { "type": "string" },
        "contacto": { "type": "string" },
        "telefono": { "type": "string" },
        "correo": { "type": "string", "format": "email" },
        "noContrato": { "type": "string" },
        "urlExterno": { "type": "string" },
        "cuentaCUP": { 
          "type": "object",
          "properties": {
            "titular": { "type": "string" },
            "cuenta": { "type": "string" },
            "banco": { "type": "string" },
            "sucursal": { "type": "string" }
          }
        },
        "cuentaInternacional": {
          "type": "object",
          "properties": {
            "pasarela": { "type": "string" },
            "titular": { "type": "string" },
            "cuenta": { "type": "string" },
            "swift": { "type": "string" },
            "banco": { "type": "string" },
            "moneda": { "type": "string" },
            "tipoCuenta": { "type": "string" },
            "telefonoTitular": { "type": "string" },
            "direccionTitular": { "type": "string" },
            "idTitular": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["negocio", "metodoPago", "estado", "area"]
    },
    "Messenger": {
      "title": "Messenger",
      "description": "Delivery fleet profile",
      "type": "object",
      "properties": {
        "nombre": { "type": "string" },
        "viaPago": { "type": "string" },
        "fechaAlta": { "type": "string" },
        "fechaBaja": { "type": "string" },
        "estado": { "type": "string", "enum": ["activo", "bloqueado"] },
        "area": { "type": "string" },
        "comentarios": { "type": "string" },
        "ci": { "type": "string" },
        "telefono": { "type": "string" },
        "correo": { "type": "string", "format": "email" },
        "noContrato": { "type": "string" },
        "cuentaFiscal": {
          "type": "object",
          "properties": {
            "titular": { "type": "string" },
            "cuenta": { "type": "string" },
            "banco": { "type": "string" },
            "sucursal": { "type": "string" }
          }
        },
        "cuentaPersonal": {
          "type": "object",
          "properties": {
            "titular": { "type": "string" },
            "cuenta": { "type": "string" },
            "banco": { "type": "string" },
            "sucursal": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nombre", "ci", "telefono", "noContrato", "estado", "area"]
    },
    "DispatcherOrder": {
      "title": "Dispatcher Order",
      "description": "Historical record of orders from dispatcher sheets",
      "type": "object",
      "properties": {
        "fecha": { "type": "string" },
        "orden": { "type": "string" },
        "orderId": { "type": "string" },
        "deliveryDate": { "type": "string" },
        "orderDate": { "type": "string" },
        "driver": { "type": "string" },
        "store": { "type": "string" },
        "negocio": { "type": "string" },
        "cliente": { "type": "string" },
        "customer": { "type": "string" },
        "customerNumber": { "type": "string" },
        "monto": { "type": "number" },
        "productAmount": { "type": "number" },
        "deliveryCharge": { "type": "number" },
        "extraDeliveryCharge": { "type": "number" },
        "driverAdminCharge": { "type": "number" },
        "complementaryDelivery": { "type": "number" },
        "storeOffer": { "type": "number" },
        "storeAdminCharge": { "type": "number" },
        "processingFee": { "type": "number" },
        "transactionFee": { "type": "number" },
        "promocode": { "type": "string" },
        "viaPago": { "type": "string" },
        "paymentType": { "type": "string" },
        "tipoOrden": { "type": "string" },
        "mensajero": { "type": "string" },
        "area": { "type": "string" },
        "origen": { "type": "string", "enum": ["habana", "holguin", "provincia"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "DispatcherCambio": {
      "title": "Dispatcher Cambio",
      "description": "Manual changes registered in dispatcher",
      "type": "object",
      "properties": {
        "fecha": { "type": "string" },
        "orden": { "type": "string" },
        "detalle": { "type": "string" },
        "origen": { "type": "string", "enum": ["habana", "holguin", "provincia"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "DispatcherDisponibilidad": {
      "title": "Dispatcher Disponibilidad",
      "description": "Extra payments (extra deliveries) registered in dispatcher",
      "type": "object",
      "properties": {
        "fecha": { "type": "string" },
        "mensajero": { "type": "string" },
        "monto": { "type": "number" },
        "detalle": { "type": "string" },
        "origen": { "type": "string", "enum": ["habana", "holguin", "provincia"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "dispatcher_orders": {
      "schema": "DispatcherOrder",
      "description": "Imported orders from dispatchers"
    },
    "dispatcher_cambios": {
      "schema": "DispatcherCambio",
      "description": "Imported changes from dispatchers"
    },
    "dispatcher_disponibilidades": {
      "schema": "DispatcherDisponibilidad",
      "description": "Imported extra payments from dispatchers"
    },
    "users": {
      "schema": "User",
      "description": "Registered users in the platform"
    },
    "roles": {
      "schema": "Role",
      "description": "RBAC role definitions"
    },
    "businesses": {
      "schema": "Business",
      "description": "Partner establishments"
    },
    "messengers": {
      "schema": "Messenger",
      "description": "Fleet messengers"
    },
    "settings": {
      "schema": {
        "type": "object",
        "properties": {
          "spreadsheetId": { "type": "string" },
          "notifyEmails": { "type": "string" }
        }
      },
      "description": "Global application configuration documents"
    },
    "admins": {
      "schema": {
        "type": "object",
        "properties": {
          "email": { "type": "string" }
        }
      },
      "description": "List of super administrators uids"
    },
    "Areas": {
      "schema": {
        "type": "object",
        "properties": {
          "nombre": { "type": "string" },
          "provincia": { "type": "string" },
          "descripcion": { "type": "string" },
          "estado": { "type": "string", "enum": ["activo", "inactivo"] },
          "spreadsheetId": { "type": "string" }
        }
      },
      "description": "Areas and provinces for dispatcher configurations"
    },
    "MetodosPago": {
      "schema": {
        "type": "object",
        "properties": {
          "nombre": { "type": "string" },
          "descripcion": { "type": "string" },
          "aplicaNegocios": { "type": "boolean" },
          "aplicaMensajeros": { "type": "boolean" },
          "estado": { "type": "string", "enum": ["activo", "inactivo"] }
        }
      },
      "description": "Homologated pay channels"
    },
    "RazonCambio": {
      "schema": {
        "type": "object",
        "properties": {
          "nombre": { "type": "string" },
          "tasaCUP": { "type": "number" },
          "descripcion": { "type": "string" },
          "estado": { "type": "string", "enum": ["activo", "inactivo"] },
          "fechaActualizacion": { "type": "string" }
        }
      },
      "description": "Internal valuation currency conversion ratios"
    }
  }
}
