rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 0.1 Primitives
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isAdmin() { 
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email == 'raul@mandao.app') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'Super Admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'super_admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'Supervisor' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'supervisor'
        ))
      ); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // 1. Validation Helpers
    function isValidUser(data) {
      return data.nombre is string && data.nombre.size() > 0 && data.nombre.size() <= 200
        && data.email is string && data.email.size() <= 100
        && data.rol is string && data.rol.size() <= 50
        && data.estado in ['activo', 'bloqueado'];
    }

    function isValidRole(data) {
      return data.nombre is string && data.nombre.size() > 0 && data.nombre.size() <= 50
        && (!('descripcion' in data) || data.descripcion == null || (data.descripcion is string && data.descripcion.size() <= 500))
        && data.permisos is list && data.permisos.size() <= 100;
    }

    function isValidBusiness(data) {
      return data.negocio is string && data.negocio.size() > 0 && data.negocio.size() <= 500
        && (!('metodoPago' in data) || data.metodoPago == null || (data.metodoPago is string && data.metodoPago.size() <= 200))
        && data.estado in ['activo', 'bloqueado']
        && (!('area' in data) || data.area == null || (data.area is string && data.area.size() <= 200))
        && (!('telefono' in data) || data.telefono == null || data.telefono == '' || (data.telefono is string && data.telefono.size() <= 100));
    }

    function isValidMessenger(data) {
      return data.nombre is string && data.nombre.size() > 0 && data.nombre.size() <= 500
        && (!('ci' in data) || data.ci == null || data.ci == '' || (data.ci is string && data.ci.size() <= 100))
        && (!('telefono' in data) || data.telefono == null || data.telefono == '' || (data.telefono is string && data.telefono.size() <= 100))
        && (!('noContrato' in data) || data.noContrato == null || data.noContrato == '' || (data.noContrato is string && data.noContrato.size() <= 100))
        && data.estado in ['activo', 'bloqueado']
        && (!('area' in data) || data.area == null || (data.area is string && data.area.size() <= 200));
    }

    // 2. Collection Rules
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidUser(incoming()) && isValidId(userId);
      allow update: if (isAdmin() || (
                      (request.auth.uid == userId || request.auth.token.email == existing().email) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['nombre', 'updatedAt', 'ultimoAcceso'])
                    )) && isValidUser(incoming());
      allow delete: if isAdmin();
    }

    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidRole(incoming()) && isValidId(roleId);
      allow delete: if isAdmin();
    }

    match /businesses/{businessId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidBusiness(incoming()) && isValidId(businessId);
      allow delete: if isSignedIn();
    }

    match /messengers/{messengerId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidMessenger(incoming()) && isValidId(messengerId);
      allow delete: if isSignedIn();
    }

    match /dispatcher_orders/{orderId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(orderId);
    }

    match /dispatcher_cambios/{cambioId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(cambioId);
    }

    match /dispatcher_disponibilidades/{dispId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(dispId);
    }

    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(orderId);
    }

    match /verification_history/{historyId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(historyId);
    }

    match /disponibilidad_verification_history/{historyId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(historyId);
    }

    match /Availability_Verifications/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    match /Availability_Incidents/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    match /Availability_Imports/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    match /Availabilities/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    match /Dispatcher_Verifications/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    match /Dispatcher_Incidents/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    match /Dispatcher_Imports/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    match /Dispatcher/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    match /EmailGroups/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    match /EmailTemplates/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    match /Areas/{areaId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /MetodosPago/{methodId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /RazonCambio/{rateId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /test/{testId} {
      allow read: if true;
    }

    match /settings/{settingsId} {
      allow read, write: if isSignedIn();
    }

    match /AuditLogs/{logId} {
      allow read, write: if isSignedIn();
    }
  }
}
